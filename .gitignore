# Repositório do JUIZ (cd-moj). Versiona só CÓDIGO; dados e runtime ficam de fora.
# Cada máquina de julgamento clona ESTE repo (não precisa do server/web do moj).

# === dados de problemas: o agente baixa por problema p/ o cache local (não versionar) ===
problems/
problems.*/
judge/problems/
judge/problems.*/
cache/

# === segredos ===
etc/worker.token
etc/*.token
etc/agent.env
*.pem
*.key
id_rsa*

# === estado de runtime / logs ===
*.log
*.pid
log/
update-log/

# === diversos ===
*.swp
*~
.DS_Store
